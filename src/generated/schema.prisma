generator client {
  provider     = "prisma-client-js"
  output       = "../src/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  Admin       Admin[]
  users       User[]
  permissions Permission[] @relation("PermissionToRole")
}

model Permission {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  roles       Role[]    @relation("PermissionToRole")
}

model Admin {
  id                Int                 @id @default(autoincrement())
  email             String              @unique
  name              String?
  password          String
  roleId            Int
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @default(now()) @updatedAt
  deletedAt         DateTime?
  role              Role                @relation(fields: [roleId], references: [id])
  adminRefreshToken adminRefreshToken[]

  @@index([email])
  @@index([roleId])
  @@index([createdAt])
}

model User {
  id                   Int                  @id @default(autoincrement())
  email                String               @unique
  name                 String?
  password             String
  image                String?
  roleId               Int
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @default(now()) @updatedAt
  dealerId             Int?
  passwordResetExpires DateTime?
  passwordResetToken   String?
  deletedAt            DateTime?
  Activation           Activation[]
  Actor                Actor[]
  Address              Address[]
  Cart                 Cart[]
  Order                Order[]
  OrderStatusHistory   OrderStatusHistory[]
  dealer               Dealer?              @relation(fields: [dealerId], references: [id])
  role                 Role                 @relation(fields: [roleId], references: [id])
  notification         notification[]
  otp                  otp?
  passwordReset        passwordReset?
  refreshToken         refreshToken[]

  @@index([email])
  @@index([roleId])
  @@index([createdAt])
  @@index([dealerId])
}

model passwordReset {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  userId    Int       @unique
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model otp {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  userId    Int       @unique
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model refreshToken {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  userId    Int
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model adminRefreshToken {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  adminId   Int
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  admin     Admin     @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([createdAt])
}

model Category {
  id          Int           @id @default(autoincrement())
  name        String        @unique
  description String?
  logo        String?
  deletedAt   DateTime?
  products    Product[]
  subCategory subCategory[]
}

model subCategory {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  categoryId  Int
  logo        String?
  deletedAt   DateTime?
  Product     Product[]
  category    Category  @relation(fields: [categoryId], references: [id])
}

model Brand {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  logo        String?
  deletedAt   DateTime?
  products    Product[]
}

model Product {
  id             Int                @id @default(autoincrement())
  name           String             @unique
  description    String
  descriptionIt  String
  dealer_price   Decimal
  retail_price   Decimal
  purchase_price Decimal
  margin         Decimal
  product_code   String             @unique
  discount       Decimal            @default(0)
  categoryId     Int
  subCategoryId  Int
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @default(now()) @updatedAt
  deletedAt      DateTime?
  brandId        Int                @default(1)
  thumbnail      String?
  totalSales     Int                @default(0)
  viewCount      Int                @default(0)
  isActive       Boolean            @default(true)
  CartItem       CartItem[]
  OrderItem      OrderItem[]
  brand          Brand              @relation(fields: [brandId], references: [id])
  category       Category           @relation(fields: [categoryId], references: [id])
  subCategory    subCategory        @relation(fields: [subCategoryId], references: [id])
  variations     ProductVariation[]
  Offer          Offer[]            @relation("OfferToProduct")
  Order          Cart[]             @relation("OrderProducts")

  @@index([categoryId])
  @@index([subCategoryId])
  @@index([brandId])
  @@index([createdAt])
  @@index([product_code])
}

model ProductVariation {
  id        Int         @id @default(autoincrement())
  img       String
  color     String
  stock     Int
  productId Int
  deletedAt DateTime?
  CartItem  CartItem[]
  OrderItem OrderItem[]
  product   Product     @relation(fields: [productId], references: [id])
}

model Order {
  id                      Int                  @id @default(autoincrement())
  userId                  Int
  total                   Decimal
  status                  String
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @default(now()) @updatedAt
  deletedAt               DateTime?
  subtotal                Decimal              @default(0)
  tax                     Decimal              @default(0)
  discount                Decimal              @default(0)
  shippingCost            Decimal              @default(0)
  paymentMethod           String?
  paymentProof            String?
  deliveryProof           String?
  orderDocument           String?
  paymentDate             String?
  deliveryDate            String?
  paymentConfirmationDate String?
  shippingDate            String?
  orderNumber             String?              @unique
  returnDate              String?
  returnProof             String?
  returnConfirmationDate  String?
  returnReason            String?
  returnStatus            String?
  remarks                 String?
  user                    User                 @relation(fields: [userId], references: [id])
  OrderItem               OrderItem[]
  OrderStatusHistory      OrderStatusHistory[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([orderNumber])
}

model OrderItem {
  id          Int              @id @default(autoincrement())
  orderId     Int
  productId   Int
  variationId Int
  quantity    Int
  price       Decimal?
  discount    Decimal?
  color       String?
  img         String?
  createdAt   DateTime         @default(now())
  deletedAt   DateTime?
  order       Order            @relation(fields: [orderId], references: [id])
  product     Product          @relation(fields: [productId], references: [id])
  variation   ProductVariation @relation(fields: [variationId], references: [id])
}

model OrderStatusHistory {
  id          Int       @id @default(autoincrement())
  orderId     Int
  status      String
  changedById Int
  remarks     String?
  changedAt   DateTime  @default(now())
  deletedAt   DateTime?
  changedBy   User      @relation(fields: [changedById], references: [id])
  order       Order     @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([changedAt])
  @@index([changedById])
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int
  total     Decimal    @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  deletedAt DateTime?
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
  products  Product[]  @relation("OrderProducts")

  @@index([userId])
  @@index([createdAt])
}

model CartItem {
  id          Int              @id @default(autoincrement())
  cartId      Int
  productId   Int
  variationId Int
  quantity    Int              @default(1)
  createdAt   DateTime         @default(now())
  deletedAt   DateTime?
  cart        Cart             @relation(fields: [cartId], references: [id])
  product     Product          @relation(fields: [productId], references: [id])
  variation   ProductVariation @relation(fields: [variationId], references: [id])
}

model Address {
  id        Int       @id @default(autoincrement())
  userId    Int
  address   String
  city      String
  state     String
  country   String
  zip       String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id])
}

model Company {
  id           Int            @id @default(autoincrement())
  name         String         @unique
  description  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now()) @updatedAt
  deletedAt    DateTime?
  logo         String?
  Activation   Activation[]
  Tarrif       Tarrif[]
  serialNumber serialNumber[]
}

model Tarrif {
  id             Int          @id @default(autoincrement())
  name           String       @unique
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  deletedAt      DateTime?
  companyId      Int
  categoryOffer  String
  categoryTarrif String
  portability    String
  client         String
  price          Decimal
  Activation     Activation[]
  company        Company      @relation(fields: [companyId], references: [id])
}

model TarrifOptions {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime?
}

model Activation {
  id                  Int          @id @default(autoincrement())
  client              String?
  portability         Boolean
  categoryOffer       String
  categoryTarrif      String
  moodOfPayment       String
  paymentDocument     String?
  paymentDate         String?
  paymentStatus       String?
  activationDate      String?
  remarks             String?
  activationDocuments String?
  price               Decimal?
  name                String?
  details             String?
  status              String       @default("Pending")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @default(now()) @updatedAt
  deletedAt           DateTime?
  userId              Int
  tarrifId            Int
  serialNumberId      Int
  companyId           Int
  company             Company      @relation(fields: [companyId], references: [id])
  serialNumber        serialNumber @relation(fields: [serialNumberId], references: [id])
  tarrif              Tarrif       @relation(fields: [tarrifId], references: [id])
  user                User         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tarrifId])
  @@index([serialNumberId])
  @@index([companyId])
  @@index([createdAt])
}

model serialNumber {
  id         Int          @id @default(autoincrement())
  number     String       @unique
  companyId  Int?
  dealerId   Int?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @default(now()) @updatedAt
  deletedAt  DateTime?
  Activation Activation[]
  company    Company?     @relation(fields: [companyId], references: [id])
  dealer     Dealer?      @relation(fields: [dealerId], references: [id])

  @@index([companyId])
  @@index([dealerId])
  @@index([createdAt])
}

model Offer {
  id            Int             @id @default(autoincrement())
  name          String          @unique
  description   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now()) @updatedAt
  deletedAt     DateTime?
  OfferCategory OfferCategory[] @relation("OfferToOfferCategory")
  products      Product[]       @relation("OfferToProduct")
}

model OfferCategory {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime?
  offers      Offer[]   @relation("OfferToOfferCategory")
}

model notification {
  id        Int       @id @default(autoincrement())
  title     String
  body      String
  type      String?
  link      String?
  userId    Int
  seen      Boolean
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([seen])
  @@index([createdAt])
}

model Dealer {
  id              Int              @id @default(autoincrement())
  dealerCode      String           @unique
  companyName     String           @unique
  vatNumber       String?          @unique
  taxCode         String?
  adminPhone      String           @unique
  pecEmail        String?          @unique
  adminEmail      String           @unique
  iban            String?          @unique
  paymentMethod   String?
  accountNumber   String?
  recoveryEmail   String?          @unique
  websiteUrl      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  billingAddress  BillingAddress?
  creditDetails   CreditDetails?
  Documents       Documents[]
  salePoints      SalePoint[]
  signedContracts SignedContract[]
  User            User[]
  serialNumber    serialNumber[]

  @@index([companyName])
  @@index([vatNumber])
  @@index([adminEmail])
  @@index([dealerCode])
}

model BillingAddress {
  id           Int       @id @default(autoincrement())
  dealerId     Int       @unique
  street       String
  number       String
  zipCode      String
  country      String
  municipality String
  province     String
  deletedAt    DateTime?
  dealer       Dealer    @relation(fields: [dealerId], references: [id])
}

model CreditDetails {
  id                   Int       @id @default(autoincrement())
  dealerId             Int       @unique
  assignedCreditLimit  Float
  invoicesToPay        Float
  availableCreditLimit Float
  escudo               Float
  creditForTopUps      Float
  deletedAt            DateTime?
  dealer               Dealer    @relation(fields: [dealerId], references: [id])
}

model SalePoint {
  id          Int       @id @default(autoincrement())
  dealerId    Int
  name        String
  address     String
  city        String
  province    String
  phoneNumber String
  deletedAt   DateTime?
  dealer      Dealer    @relation(fields: [dealerId], references: [id])
}

model SignedContract {
  id        Int       @id @default(autoincrement())
  dealerId  Int
  name      String
  signedOn  DateTime
  fileUrl   String
  deletedAt DateTime?
  dealer    Dealer    @relation(fields: [dealerId], references: [id])
}

model Documents {
  id        Int       @id @default(autoincrement())
  dealerId  Int
  name      String
  fileUrl   String
  deletedAt DateTime?
  dealer    Dealer    @relation(fields: [dealerId], references: [id])
}

model Workflow {
  id          Int            @id @default(autoincrement())
  type        String
  referenceId String
  status      String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?
  steps       WorkflowStep[]
}

model WorkflowStep {
  id         Int       @id @default(autoincrement())
  workflowId Int
  action     String
  actorId    Int
  actorRole  String
  metadata   Json?
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  workflow   Workflow  @relation(fields: [workflowId], references: [id])
  Actor      Actor[]   @relation("ActorToWorkflowStep")

  @@index([workflowId])
  @@index([actorId])
  @@index([createdAt])
}

model Actor {
  id        Int            @id @default(autoincrement())
  name      String
  role      String
  email     String?        @unique
  userId    Int?
  deletedAt DateTime?
  user      User?          @relation(fields: [userId], references: [id])
  workflows WorkflowStep[] @relation("ActorToWorkflowStep")
}

model Banner {
  id        Int       @id @default(autoincrement())
  title     String
  image     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?
}

model Pages {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  content     String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt
  deletedAt   DateTime?
  SiteInfo    SiteInfo[] @relation("PagesToSiteInfo")
}

model Faq {
  id        Int        @id @default(autoincrement())
  question  String
  answer    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  deletedAt DateTime?
  SiteInfo  SiteInfo[] @relation("FaqToSiteInfo")
}

model SocialMedia {
  id        Int        @id @default(autoincrement())
  name      String
  link      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  deletedAt DateTime?
  SiteInfo  SiteInfo[] @relation("SiteInfoToSocialMedia")
}

model SiteInfo {
  id          Int           @id @default(autoincrement())
  title       String
  description String?
  webLogo     String?
  mobileLogo  String?
  favicon     String?
  email       String
  phone       String
  address     String?
  city        String?
  state       String?
  zip         String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
  deletedAt   DateTime?
  faq         Faq[]         @relation("FaqToSiteInfo")
  pages       Pages[]       @relation("PagesToSiteInfo")
  socialMedia SocialMedia[] @relation("SiteInfoToSocialMedia")
}

model Analytics {
  id           Int      @id @default(autoincrement())
  date         DateTime @default(now())
  totalSales   Decimal  @default(0)
  orderCount   Int      @default(0)
  productViews Int      @default(0)
  activeUsers  Int      @default(0)
  topProducts  Json?
  type         String
  metadata     Json?

  @@index([date])
  @@index([type])
}
